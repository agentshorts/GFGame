{
  "$schema": "./node_modules/wrangler/config-schema.json",
  // Persona API for Dino Chat Lab. Cloudflare Bot deploys this after review.
  // No routes and no account id. Do not attach DNS or the old 4square worker.
  "name": "dino-chat-lab",
  "main": "worker/index.ts",
  "compatibility_date": "2026-10-30",
  "compatibility_flags": ["nodejs_compat"],
  "upload_source_maps": true,
  "observability": {
    "enabled": true,
    "logs": {
      "head_sampling_rate": 1
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 1
    }
  },
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "durable_objects": {
    "bindings": [
      { "name": "PERSONA_HUB", "class_name": "PersonaHub" },
      { "name": "SIGNUP_LIMITER", "class_name": "SignupLimiter" }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["PersonaHub", "SignupLimiter"]
    }
  ]
}
